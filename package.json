{
  "name": "@chatropic/react-native",
  "version": "0.1.0",
  "description": "React Native SDK for embedding Chatropic chat widgets in mobile apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chatropic/chatropic-react-native-sdk.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "write:development-endpoint": "node scripts/write-development-endpoint.js",
    "write:production-endpoint": "node scripts/write-production-endpoint.js",
    "prepack": "npm run build",
    "release:scan": "node scripts/scan-package-surface.js",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-linear-gradient": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
